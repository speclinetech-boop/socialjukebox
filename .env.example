# Spotify Web API credentials (required)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Shared proxy key. Once set in Vercel, all /api/spotify/* callers must send it
# via X-Api-Key, Authorization: Bearer, or ?key= (for the Spotify iOS SDK URLs).
# Must match SpotifyAuthManager.proxyAPIKey in the iOS app.
SPOTIFY_PROXY_API_KEY=

# Comma-separated OAuth redirect URI allowlist (optional).
# Default: socialjukebox://spotify-callback
SPOTIFY_REDIRECT_URIS=socialjukebox://spotify-callback
